{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-frame-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Holds the Spotify refresh token. Locally, wrangler keeps it in .wrangler/state (ignored).
  // Before deploying, create a real namespace (`npx wrangler kv namespace create STORE`) and
  // put its id here.
  "kv_namespaces": [{ "binding": "STORE", "id": "local-store" }]
}
