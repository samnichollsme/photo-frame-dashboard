{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-frame-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  // Version preview URLs would be extra public addresses for the same Worker; not needed.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs first for every path so ACCESS_KEY also guards the page.
    "run_worker_first": true
  },
  // Holds the Spotify refresh token. `wrangler dev` uses a local copy in .wrangler/state (ignored).
  "kv_namespaces": [{ "binding": "STORE", "id": "c71483122f7748b79ea1778223159b82" }]
}
